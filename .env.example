# ============================================================================
# CheckR — Environment configuration
# Copy to `.env` and fill in values. NEVER commit the real `.env`.
# ============================================================================

# --- Application ---
APP_NAME=CheckR
ENVIRONMENT=development                # development | production
DEBUG=true
API_PREFIX=/api
# Public origin of the frontend (used for CORS + building absolute URLs)
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:8000

# --- Database (PostgreSQL) ---
# Compose overrides host to `postgres`. For local (non-docker) use localhost.
DATABASE_URL=postgresql+asyncpg://checkr:checkr@localhost:5432/checkr
# Used by Alembic (sync driver)
DATABASE_URL_SYNC=postgresql+psycopg://checkr:checkr@localhost:5432/checkr
# Host ports published by docker compose (change if already in use locally).
# BACKEND_HOST_PORT is the single source of truth for the backend port: the
# frontend dev server reads it to decide what /api proxies to when run from the
# host, so change it here rather than in two places.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- Redis (job signalling + cache; optional for correctness) ---
REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6379

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Account provisioning. CheckR is institution-controlled infrastructure:
# accounts are created by an administrator (seed script / operator), not by
# visitors to the sign-in screen. Set to true only if open sign-up is a
# deliberate decision for this deployment.
SELF_REGISTRATION_ENABLED=false

# Development-only convenience: lets the sign-in screen display the seeded demo
# account. Never exposed in production, whatever this is set to.
#   (unset) -> shown in development only
#   false   -> never shown
#   true    -> shown wherever it is safe
# EXPOSE_DEMO_CREDENTIALS=true

# --- AI provider abstraction ---
# mock   -> deterministic, no network calls (default, safe, free)
# gemini | openai | anthropic | local
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2

# Evaluation confidence thresholds (0-1)
AI_CONFIDENCE_HIGH=0.85
AI_CONFIDENCE_MEDIUM=0.60

# --- Object / file storage ---
# local -> filesystem (development).  s3 -> S3-compatible (production)
STORAGE_PROVIDER=local
STORAGE_PATH=./storage_data
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Uploads ---
MAX_UPLOAD_MB=40
MAX_SUBMISSION_PAGES=80

# --- Background worker ---
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_ATTEMPTS=3

# --- Seed data ---
SEED_ON_STARTUP=true
SEED_TEACHER_EMAIL=teacher@checkr.edu
SEED_TEACHER_PASSWORD=CheckR!2026
